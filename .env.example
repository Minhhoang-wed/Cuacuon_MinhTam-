# Supabase quản lý đăng nhập Admin, dữ liệu catalog và kho ảnh.
# Có thể để trống khi xem bản demo local; trang public sẽ dùng dữ liệu mẫu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL nhận yêu cầu từ form (Make/Zapier/n8n/backend nội bộ). Bỏ trống khi chạy demo local.
SERVICE_REQUEST_WEBHOOK_URL=
SERVICE_REQUEST_WEBHOOK_TOKEN=

# URL website thật sau khi triển khai, ví dụ https://cuacuonantam.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000
